# Golden-Fixtures (S0c, report-worker/tests/golden/).
# Die Roh-Tars sind Binaerdaten: kein Diff, keine Zeilenendenkonvertierung,
# kein Merge-Versuch. Die JSON-Fixtures bleiben Text mit LF, damit Aenderungen
# an Soll-Listen und Negativ-Fixtures im Diff lesbar sind.
report-worker/tests/golden/tars/** binary
report-worker/tests/golden/**/*.json text eol=lf
report-worker/tests/golden/orders.txt text eol=lf

# Pruefkatalog (S2, report-worker/reporter/catalog/ und tests/catalog/).
# YAML, Tabellen und Fixtures bleiben Text mit LF; der Katalog-Digest und die
# Fixture-Vergleiche muessen unter Windows und Linux denselben Wert liefern.
report-worker/reporter/catalog/**/*.yaml text eol=lf
report-worker/reporter/catalog/*.md text eol=lf
report-worker/tests/catalog/**/*.json text eol=lf

# Renderer v3 (S4, report-worker/reporter/pdf/v3/).
# Die Inter-Schnitte und der HTML-Schnappschuss sind Binaerdaten. Vorlage und SVG
# bleiben Text mit LF: Jinja normalisiert Zeilenenden zwar beim Lesen, aber der
# Schnappschuss wird byteweise verglichen und darf nicht am Betriebssystem haengen
# (dieselbe Falle wie der EOL-Feed-Hash in S1).
report-worker/reporter/pdf/v3/assets/fonts/*.ttf binary
report-worker/tests/golden/render/*.gz binary
report-worker/reporter/pdf/v3/templates/*.j2 text eol=lf
report-worker/reporter/pdf/v3/assets/*.svg text eol=lf

# spec-Dokumente immer LF, unabhaengig vom Windows-Working-Tree (CRLF-Drift, 20.09.).
report-prototype/spec/**/*.md text eol=lf
