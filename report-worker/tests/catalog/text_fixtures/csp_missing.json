{
 "check": "csp_missing",
 "cases": [
  {
   "name": "Keine Content-Security-Policy",
   "facts": {
    "http": [
     {
      "host_ip": "10.0.0.1",
      "fqdn": "www.example.test",
      "reachable": true,
      "csp": {
       "present": false
      }
     }
    ]
   },
   "coverage_default": "ok",
   "expect": {
    "holds": {
     "www.example.test@10.0.0.1": [
      "observation[0]",
      "meaning[0]",
      "recommendation[0]"
     ]
    },
    "not_holds": {
     "www.example.test@10.0.0.1": [
      "observation[1]",
      "meaning[1]",
      "recommendation[1]",
      "short_variants[0]",
      "short_variants[1]"
     ]
    }
   }
  },
  {
   "name": "S6b-4n (spec/11 N1, huendgen www): nur frame-ancestors, keine Regel für Skriptquellen",
   "facts": {
    "http": [
     {
      "host_ip": "10.0.0.1",
      "fqdn": "www.example.test",
      "reachable": true,
      "csp": {
       "present": true,
       "value": "frame-ancestors 'self'",
       "unsafe_inline": false,
       "unsafe_eval": false,
       "wildcard": false,
       "frame_ancestors": "'self'",
       "script_rule": false
      }
     }
    ]
   },
   "coverage_default": "ok",
   "expect": {
    "holds": {
     "www.example.test@10.0.0.1": [
      "observation[1]",
      "meaning[1]",
      "recommendation[1]",
      "short_variants[0]",
      "short_variants[1]"
     ]
    },
    "not_holds": {
     "www.example.test@10.0.0.1": [
      "observation[0]",
      "meaning[0]",
      "recommendation[0]"
     ]
    }
   }
  },
  {
   "name": "S6b-4n (spec/11 N1): Richtlinie ohne Skriptregel und ohne frame-ancestors",
   "facts": {
    "http": [
     {
      "host_ip": "10.0.0.1",
      "fqdn": "www.example.test",
      "reachable": true,
      "csp": {
       "present": true,
       "value": "upgrade-insecure-requests",
       "unsafe_inline": false,
       "unsafe_eval": false,
       "wildcard": false,
       "script_rule": false
      }
     }
    ]
   },
   "coverage_default": "ok",
   "expect": {
    "holds": {
     "www.example.test@10.0.0.1": [
      "observation[1]",
      "meaning[1]",
      "recommendation[1]",
      "short_variants[1]"
     ]
    },
    "not_holds": {
     "www.example.test@10.0.0.1": [
      "observation[0]",
      "meaning[0]",
      "recommendation[0]",
      "short_variants[0]"
     ]
    }
   }
  }
 ]
}
