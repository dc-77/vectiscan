# Lokale Entwicklung — docker-compose.dev.yml
DATABASE_URL=postgres://vectiscan:devpassword@localhost:5432/vectiscan
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
NODE_ENV=development

# S0a: Gate blockiert lokal, damit Report-Defekte hier auffallen und nicht
# erst im Kundenreport. Produktion bleibt bis Session S5 auf 'warn'.
VECTISCAN_VALIDATION_LEVEL=strict
